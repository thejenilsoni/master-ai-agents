# Copy this file to .env and fill in your real key. Never commit .env.
# OpenAI (https://platform.openai.com/api-keys) powers --online: the embedding
# model text-embedding-3-small for retrieval and gpt-4o-mini for the answer.
# Everything else in this project, including --selftest, runs without a key.
OPENAI_API_KEY=your_openai_api_key
