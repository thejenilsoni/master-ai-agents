# Copy this file to .env and fill in your real key. Never commit .env.
# OpenAI (https://platform.openai.com/api-keys) powers --online: the embedding
# model text-embedding-3-small for the dense half of the hybrid, and gpt-4o-mini
# for the answer. BM25 needs no key, and neither does --selftest.
OPENAI_API_KEY=your_openai_api_key
