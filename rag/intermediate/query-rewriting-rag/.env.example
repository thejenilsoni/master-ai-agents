# Copy this file to .env and fill in your real key. Never commit .env.
# OpenAI (https://platform.openai.com/api-keys) powers --online: gpt-4o-mini
# writes the sub-queries and the HyDE passage, and text-embedding-3-small
# embeds them. Offline stand-ins cover both, so --selftest needs no key.
OPENAI_API_KEY=your_openai_api_key
