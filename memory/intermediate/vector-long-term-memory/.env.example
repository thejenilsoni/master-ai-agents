# Copy this file to .env and fill in your real key. Never commit .env.
# OpenAI (https://platform.openai.com/api-keys) powers both the chat model
# (gpt-4o-mini) and the embedding model (text-embedding-3-small).
# Not needed for --demo or --selftest, which use a deterministic offline
# embedder and the standard library alone.
OPENAI_API_KEY=your_openai_api_key
