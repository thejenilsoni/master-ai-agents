# Copy this file to .env and fill in your real key. Never commit .env.
# OpenAI (https://platform.openai.com/api-keys) powers every routed chain.
# The billing / technical / general arms use gpt-4o-mini; the code arm tries
# gpt-4o first and falls back to gpt-4o-mini.
OPENAI_API_KEY=your_openai_api_key
