# Copy this file to .env and fill in your real values. Never commit .env.
# All settings are read with the AGENT_ prefix (see app/config.py).

# --- Model provider ---
# OpenAI key (https://platform.openai.com/api-keys). Leave unset to run the
# service with the built-in stub model, which needs no key.
AGENT_OPENAI_API_KEY=your_openai_api_key
AGENT_PROVIDER=openai
AGENT_MODEL=gpt-4o-mini

# --- Service identity ---
AGENT_SERVICE_NAME=agent-service
AGENT_ENVIRONMENT=development
AGENT_LOG_LEVEL=INFO

# --- Auth ---
# Comma-separated list of accepted client API keys for the X-API-Key header.
AGENT_API_KEYS=local-dev-key
AGENT_API_KEY_HEADER=X-API-Key

# --- Limits ---
AGENT_RATE_LIMIT_REQUESTS=30
AGENT_RATE_LIMIT_WINDOW_S=60
AGENT_REQUEST_TIMEOUT_S=30
AGENT_MAX_MESSAGE_CHARS=8000
AGENT_MAX_HISTORY_MESSAGES=20
