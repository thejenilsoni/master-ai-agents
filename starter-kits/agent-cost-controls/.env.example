# Copy this file to .env and fill in your real key. Never commit .env.
#
# The kit itself needs no key: `demo.py` and the whole test suite run against a stubbed
# model client. A key is only needed once you wrap a real provider.
OPENAI_API_KEY=your_openai_api_key

# --- Budgets -------------------------------------------------------------------
# Spend ceilings in your billing currency. Leave blank for "unlimited", but prefer a
# number: an unlimited budget is not a budget.
COST_MAX_COST_PER_REQUEST=0.05
COST_MAX_COST_PER_SESSION=2.00
COST_MAX_CALLS_PER_REQUEST=8
# Seconds of inactivity after which a session's spend resets.
COST_SESSION_TTL_S=3600

# --- Model routing -------------------------------------------------------------
# Ordered cheapest-first. The router escalates only when the quality gate rejects.
COST_CHEAP_MODEL=gpt-4o-mini
COST_STRONG_MODEL=gpt-4o
# Prompts at or above this token estimate start one tier up.
COST_LONG_PROMPT_TOKENS=4000

# --- Cache ---------------------------------------------------------------------
COST_CACHE_MAX_ENTRIES=512
COST_CACHE_TTL_S=3600
# Responses above this temperature are not deterministic enough to reuse.
COST_CACHE_MAX_TEMPERATURE=0.2

# --- Retry and circuit breaker -------------------------------------------------
COST_RETRY_MAX_ATTEMPTS=5
COST_RETRY_BASE_DELAY_S=0.5
COST_RETRY_MAX_DELAY_S=30
COST_BREAKER_FAILURE_THRESHOLD=5
COST_BREAKER_RESET_TIMEOUT_S=30
