# Copy this file to .env and fill in your real key. Never commit .env.
#
# The kit itself needs no key: `demo.py` and the whole test suite run against a stubbed
# model client. A key is only needed once you point the tracer at a real provider.
OPENAI_API_KEY=your_openai_api_key

# Where trace JSON and JSONL are written.
OBS_TRACE_DIR=traces

# Number of finished traces kept in memory per process. Bounded on purpose: an
# unbounded in-process trace buffer is a memory leak in a long-lived server.
OBS_MAX_TRACES=100
