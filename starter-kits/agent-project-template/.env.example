# Copy this file to .env and fill it in. Never commit .env.

# Required unless AGENT_OFFLINE=1. https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key

# Set to 1 to use the deterministic provider: no key, no network, no spend.
AGENT_OFFLINE=0

# Optional; the defaults are the values shown.
AGENT_MODEL=gpt-4o-mini
AGENT_MAX_TOOL_ROUNDS=4
AGENT_TIMEOUT_S=30
LOG_LEVEL=INFO
LOG_FORMAT=json
