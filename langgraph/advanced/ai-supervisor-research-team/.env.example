# Copy this file to .env and fill in your keys. Never commit .env.

# Required: powers the supervisor and every specialist agent.
OPENAI_API_KEY=your_openai_api_key

# Optional: enables real web search in the researcher agent.
# Leave empty to run fully offline (the researcher falls back to model knowledge).
# Get a free key at https://tavily.com
TAVILY_API_KEY=

# Optional overrides
# SUPERVISOR_MODEL=gpt-4o-mini
# SUPERVISOR_MAX_STEPS=8
