# Copy this file to .env and fill in your real key. Never commit .env.
# OpenAI (https://platform.openai.com/api-keys) powers --grader openai, which
# grades claim-level faithfulness and answer relevance. Retrieval metrics
# (hit rate, recall, precision, MRR) never need a key.
OPENAI_API_KEY=your_openai_api_key
