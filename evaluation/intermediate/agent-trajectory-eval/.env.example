# Copy this file to .env and fill in your real key. Never commit .env.
# OpenAI (https://platform.openai.com/api-keys) is only used by --live, which
# runs a real tool-calling agent to produce a fresh trace. Scoring the recorded
# traces in dataset.jsonl needs no key and spends zero tokens.
OPENAI_API_KEY=your_openai_api_key
