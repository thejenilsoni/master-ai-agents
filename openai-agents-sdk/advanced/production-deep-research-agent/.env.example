# Required
OPENAI_API_KEY=

# Model routing
RESEARCH_COORDINATOR_MODEL=gpt-5.4
RESEARCH_WORKER_MODEL=gpt-5.4-mini
RESEARCH_CRITIC_MODEL=gpt-5.4

# Runtime controls
RESEARCH_MAX_SUBQUESTIONS=6
RESEARCH_MAX_CONCURRENCY=4
RESEARCH_MIN_SOURCES=8
RESEARCH_MAX_REVISIONS=2
RESEARCH_DATABASE_PATH=.data/research.db
RESEARCH_OUTPUT_DIR=outputs
RESEARCH_AUTO_APPROVE=false

# Set to 1 to disable OpenAI trace export.
OPENAI_AGENTS_DISABLE_TRACING=0
