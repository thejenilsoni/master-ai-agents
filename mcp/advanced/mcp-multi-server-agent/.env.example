# Copy this file to .env and fill in your real key. Never commit .env.
# OpenAI (https://platform.openai.com/api-keys) powers the agent. The MCP servers
# it connects to need no key of their own.
OPENAI_API_KEY=your_openai_api_key

# Optional overrides
# MCP_AGENT_MODEL=gpt-4o-mini

# The servers themselves are chosen with repeatable --server name=/path flags,
# for example:
#   python multi_server_agent.py --server docs=/path/to/filesystem_server.py "..."
# With no flags the agent launches the three servers built in this category.
