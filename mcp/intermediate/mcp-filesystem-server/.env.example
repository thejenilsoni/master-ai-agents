# Copy this file to .env and fill in your real key. Never commit .env.
# This project needs no API key: it is a pure MCP server, and the model lives in
# whichever client connects to it. Only the settings below are configurable.

# The one directory this server may read. Everything outside it is refused.
# Defaults to the ./documents folder shipped with this project.
# MCP_DOCS_ROOT=/absolute/path/to/a/folder/you/trust

# Hard cap on how many bytes a single read_file call may return.
# MCP_DOCS_MAX_BYTES=20000

# The name this server reports during the MCP handshake.
# MCP_SERVER_NAME=documents
