# Copy this file to .env and fill in your real key. Never commit .env.
# OpenAI (https://platform.openai.com/api-keys) powers the agent. The MCP server
# itself needs no key.
OPENAI_API_KEY=your_openai_api_key

# Optional overrides
# MCP_CLIENT_MODEL=gpt-4o-mini
# Absolute path to the MCP server script this client should launch. Defaults to
# the companion server at ../mcp-server-basics/basics_server.py
# MCP_SERVER_SCRIPT=/absolute/path/to/basics_server.py
