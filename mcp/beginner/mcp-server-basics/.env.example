# Copy this file to .env and fill in your real key. Never commit .env.
# This project needs no API key: it is a pure MCP server, and the model lives in
# whichever client connects to it. Only the settings below are configurable.

# The name this server reports during the MCP handshake. Clients display it, and
# multi-server agents use it to disambiguate colliding tool names.
# MCP_SERVER_NAME=bookshelf
